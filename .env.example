# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-or-anon-key>
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy alias for publishable key>
SUPABASE_SERVICE_ROLE_KEY=<your-new-secret-key-after-rotation>

# For local Python scripts (scripts/check_supabase_agric.py etc.)
# Run: set SUPABASE_URL=... && set SUPABASE_SERVICE_ROLE_KEY=... before executing
SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side exam question rewriting (historical exam text is sent to Google Gemini).
GEMINI_API_KEY=<your-gemini-api-key>
EXAM_GENERATION_MODEL=gemini-3.8-flash

# Google Sheets mark entry via Vercel OIDC workload identity federation (no key file).
GCP_PROJECT_ID=<google-cloud-project-id>
GCP_PROJECT_NUMBER=<google-cloud-project-number>
GCP_SERVICE_ACCOUNT_EMAIL=<service-account-email>
GCP_WORKLOAD_IDENTITY_POOL_ID=<pool-id>
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=<provider-id>
# Optional override for Google's STS audience (full provider resource name):
# GCP_AUDIENCE=//iam.googleapis.com/projects/<project-number>/locations/global/workloadIdentityPools/<pool-id>/providers/<provider-id>
