# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-or-anon-key>
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy alias for publishable key>
SUPABASE_SERVICE_ROLE_KEY=<your-new-secret-key-after-rotation>

# For local Python scripts (scripts/check_supabase_agric.py etc.)
# Run: set SUPABASE_URL=... && set SUPABASE_SERVICE_ROLE_KEY=... before executing
SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side exam question rewriting (historical exam text is sent to Google Gemini).
GEMINI_API_KEY=<your-gemini-api-key>
EXAM_GENERATION_MODEL=gemini-3.8-flash

# Google Sheets mark entry using the department's Google OAuth account.
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://academic-timetabler.vercel.app/api/assessment/google-auth/callback
# Base64-encoded 32-byte secret used to encrypt Google OAuth refresh tokens at rest.
GOOGLE_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-secret>
